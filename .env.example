# ── AWS Bedrock (native Converse API) ─────────────────────────────────────────
# The avatar's chat "brain" runs on Amazon Bedrock via the Converse API. The
# Bedrock API key is passed as a Bearer token — no AWS credentials or SigV4
# signing needed.
#
#   BEDROCK_REGION : Bedrock runtime region, e.g. ap-southeast-1 (Singapore).
#   CHAT_API_KEY   : your Amazon Bedrock API key. Long-term keys start with
#                    "ABSK"; short-term keys start with "bedrock-api-key-" and
#                    are region-locked + expire (~12h).
#   CHAT_MODEL     : a model or inference-profile id available in your region.
#                    A "global." profile routes across regions (e.g.
#                    global.anthropic.claude-opus-4-5-20251101-v1:0). Region
#                    profiles use the apac./us./eu. prefix. Note: Claude Sonnet
#                    4.6 is not offered in ap-southeast-1.
BEDROCK_REGION=ap-southeast-1
CHAT_API_KEY=ABSK-your-bedrock-api-key-here
CHAT_MODEL=global.anthropic.claude-opus-4-5-20251101-v1:0

# ── OpenAI (TTS, Whisper transcription, image generation, vision) ─────────────
# Bedrock does not provide these, so the avatar still uses OpenAI for speech,
# transcription, DALL·E image generation, and webcam/sketch vision. Supply your
# own OpenAI key to enable voice + image features; text chat works without it.
OPENAI_API_KEY=sk-your-key-here

# Express server port (defaults to 3001 if unset).
PORT=3001

# Display name and persona used by the avatar (client UI + server system prompts).
# VITE_ prefix is required so Vite exposes it to the browser bundle; the server
# also reads the same variable via dotenv.
VITE_AVATAR_NAME=kenken64

# TTS voice used by the avatar (OpenAI). Uncomment one line:
# Male voices:
TTS_VOICE=onyx
# TTS_VOICE=echo
# TTS_VOICE=fable
# TTS_VOICE=alloy
# Female voices:
# TTS_VOICE=nova
# TTS_VOICE=shimmer
